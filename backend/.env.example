# ─────────────────────────────────────────────────────────────────────────────
# DMCT Hospital – Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to Git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PhonePe Credentials ───────────────────────────────────────────────────────
# UAT / Sandbox (publicly available test credentials – safe for development)
PHONEPE_MERCHANT_ID=PGTESTPAYUAT86
PHONEPE_SALT_KEY=96434309-7796-489d-8924-ab56988a6076
PHONEPE_SALT_INDEX=1

# PhonePe API endpoints
# Sandbox:
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox/pg/v1/pay
PHONEPE_STATUS_URL=https://api-preprod.phonepe.com/apis/pg-sandbox/pg/v1/status
# Production (uncomment when going live):
# PHONEPE_BASE_URL=https://api.phonepe.com/apis/hermes/pg/v1/pay
# PHONEPE_STATUS_URL=https://api.phonepe.com/apis/hermes/pg/v1/status

# ── Redirect URLs ─────────────────────────────────────────────────────────────
# This backend endpoint (PhonePe POSTs here after payment)
REDIRECT_URL=http://localhost:5000/api/payment/callback

# Your React frontend pages (user is redirected here after PhonePe)
FRONTEND_SUCCESS_URL=http://localhost:5173/payment-success
FRONTEND_FAILURE_URL=http://localhost:5173/payment-failure

# Allowed CORS origin
FRONTEND_URL=http://localhost:5173

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
# Brevo transactional email service (replaces SMTP)
# Free tier: 9,000 emails/month, 300/day
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here

# Sender identity shown in the email client
EMAIL_FROM_NAME=DMCT Hospital & Old Age Home
EMAIL_FROM_ADDRESS=your-verified@gmail.com

# ── Admin Email (optional) ────────────────────────────────────────────────────
# If set, an admin notification with the updated Excel ledger is sent here
# after every successful payment. Leave blank to disable.
ADMIN_EMAIL=admin@yourdomain.com
